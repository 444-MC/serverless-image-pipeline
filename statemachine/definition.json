{
  "Comment": "Serverless Image Processing Pipeline Capstone Project",
  "StartAt": "ResizeImageTask",
  "States": {
    "ResizeImageTask": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:816772454920:function:image-resizer-function",
      "ResultPath": "$.lambdaResult",
      "Next": "CheckResizeResult"
    },
    "CheckResizeResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.lambdaResult.statusCode",
          "NumericEquals": 200,
          "Next": "ProcessingSuccess"
        }
      ],
      "Default": "ProcessingFail"
    },
    "ProcessingSuccess": {
      "Type": "Succeed"
    },
    "ProcessingFail": {
      "Type": "Fail",
      "Error": "ImageProcessingError",
      "Cause": "The Lambda function failed to resize the image."
    }
  }
}